		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.1.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
