		"@iconify-json/octicon": "^1.2.29",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.4",
		"@tailwindcss/vite": "^4.3.2",
		"@types/better-sqlite3": "^7.6.13",
