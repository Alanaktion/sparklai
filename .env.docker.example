# Docker Compose environment configuration.
#
# Copy this file to .env before running `docker compose up` — the app service loads it via
# `env_file: .env` in docker-compose.yml. See backend/.env.example for what each variable does;
# this file just sets Docker-network-aware defaults (service names instead of 127.0.0.1) for the
# bundled ollama/stable-diffusion services docker-compose.yml also starts.

# Required in any real deployment — generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me

# Default (using the included ollama service):
CHAT_URL=http://ollama:11434/v1/
# For services on your host machine instead: http://host.docker.internal:1234/v1/
# For OpenAI: https://api.openai.com/v1/ (also set CHAT_API_KEY)
CHAT_MODEL=llama3.1:8b
# CHAT_API_KEY=your-api-key-here

# Default (using the included stable-diffusion service):
SD_URL=http://stable-diffusion:7860/sdapi/v1/
# For services on your host machine instead: http://host.docker.internal:7860/sdapi/v1/
SD_BACKEND=automatic1111

SD_PHOTO_MODEL=dreamshaper_8_93211
SD_PHOTO_PROMPT="RAW photo,8k uhd,dslr,high quality"
SD_PHOTO_NEGATIVE_PROMPT="nsfw,underexposed,underexposure,overexposure,overexposed,canvas frame,cartoon,3d,3d render,CGI,computer graphics"

SD_DRAWING_MODEL=rabbit_v7
SD_DRAWING_PROMPT="masterpiece,best quality,absurdres,highres"
SD_DRAWING_NEGATIVE_PROMPT="3d,3d render,CGI,computer graphics"

SD_STYLIZED_MODEL=restlessexistence_v30Reflection
SD_STYLIZED_PROMPT="(Maya 3d render:1.05),(masterpiece:1.3),(hires,high resolution:1.3),subsurface scattering,ambient occlusion,bloom"
SD_STYLIZED_NEGATIVE_PROMPT="underexposed,underexposure,overexposure,overexposed,canvas frame,cartoon"

# ComfyUI settings (when SD_BACKEND=comfyui)
# SD_URL=http://host.docker.internal:8188/
# SD_COMFY_POLL_INTERVAL_MS=1500
# SD_COMFY_TIMEOUT_MS=180000

# SD_SDXL_MODEL=realDream_sdxlPony17_fp16
# SD_SDXL_PROMPT="(best quality, masterpiece:1.3), (realistic:1.2), (photo-realistic:1.2),"
# SD_SDXL_NEGATIVE_PROMPT="(worst quality, low quality:1.3), (lowres:1.2), (bad anatomy:1.2), (watermark:1.2), (error:1.2), (cropped:1.2),"
