# Copy to `.env` and adjust. All values are optional; the defaults target local
# development with a SQLite database next to the project root.
APP_NAME="Sparkl Chat"
DEBUG=false

# SQLite (default) or PostgreSQL, e.g.
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sparklchat
DATABASE_URL=sqlite+aiosqlite:///./sparklchat.db

# Used to sign auth tokens. MUST be changed in production.
SECRET_KEY=insecure-development-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional dedicated Fernet key for encrypting provider API keys at rest
# (44 url-safe base64 characters). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When unset, a key is derived from SECRET_KEY, so rotating SECRET_KEY would make
# stored provider keys unreadable. Set this before you have keys worth keeping.
# ENCRYPTION_KEY=

# Directory holding the built Svelte app (defaults to frontend/build). When it is
# absent the server exposes the API only.
# FRONTEND_DIST_DIR=frontend/build

# Directory for uploaded character avatars (defaults to data/avatars).
# AVATAR_DIR=data/avatars

# Prompt assembly. The tokenizer is "auto" (use tiktoken when available, else a
# character-based estimate) or "heuristic" to always use the estimate.
# TOKENIZER=auto
# CONTEXT_WINDOW=8192
# CONTEXT_RESERVE=512
