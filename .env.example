# Copy to `.env` and adjust. All values are optional; the defaults target local
# development with a SQLite database next to the project root.
APP_NAME=Sparkl Chat
DEBUG=false

# SQLite (default) or PostgreSQL, e.g.
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sparklchat
DATABASE_URL=sqlite+aiosqlite:///./sparklchat.db

# Used to sign auth tokens and encrypt provider API keys. MUST be changed in production.
SECRET_KEY=insecure-development-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
