# Assumes the process is run from the backend/ directory (e.g. `cd backend && uv run uvicorn ...`),
# so this resolves to the same local.db the SvelteKit app used at the repo root.
DATABASE_URL=sqlite+aiosqlite:///../local.db

# Signs the session cookie. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me

CHAT_URL=http://127.0.0.1:1234/v1/
CHAT_MODEL=meta-llama-3.1-8b-instruct
# CHAT_API_KEY=your-api-key  # Optional: required for hosted APIs, not needed for local endpoints

# Stable Diffusion settings are not yet consumed by the FastAPI backend (see BACKEND_MIGRATION.md,
# item 4) but are reserved here so config.py already has a home for them once that lands.
SD_URL=http://127.0.0.1:7860/sdapi/v1/
SD_BACKEND=automatic1111

LOG_LEVEL=INFO
DEBUG=false
